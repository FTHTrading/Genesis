# Deployer private key (0x prefixed)
DEPLOYER_PRIVATE_KEY=0x...

# Polygon RPC endpoints
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygonscan for contract verification
POLYGONSCAN_API_KEY=...

# Token allocation addresses (defaults to deployer if empty)
GENESIS_ADMIN=0x...
GENESIS_TREASURY=0x...
GENESIS_ECOSYSTEM=0x...
GENESIS_TEAM=0x...
GENESIS_LIQUIDITY=0x...
