# Genesis Protocol — Environment Configuration
#
# Copy this file to .env and set real values before deploying.
# NEVER commit .env to version control — it is .gitignored.

# ── Logging ──────────────────────────────────────────────────────────────
# RUST_LOG=info

# ── Moltbook Adapter (Outbound) ──────────────────────────────────────────
# Set MOLTBOOK_API_KEY to enable the adapter.
# Get your key: POST https://www.moltbook.com/api/v1/agents/register
#
# MOLTBOOK_API_KEY=moltbook_sk_your_key_here
# MOLTBOOK_SUBMOLT=general
# MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
# MOLTBOT_POST_INTERVAL=1800
# MOLTBOT_MAX_RETRIES=2
# MOLTBOT_TIMEOUT_SECS=10

# ── x402 Payment Layer ───────────────────────────────────────────────────
# Set GENESIS_X402_ENABLED=true to require USDC micropayments on /api/* routes.
# When disabled, all routes are free and open.
GENESIS_X402_ENABLED=false

# Genesis hot wallet address (receives USDC settlements from patrons).
GENESIS_X402_PAY_TO=0x0000000000000000000000000000000000000000

# Coinbase Developer Platform credentials (https://portal.cdp.coinbase.com/)
GENESIS_X402_CDP_API_KEY=
GENESIS_X402_CDP_API_SECRET=

# Facilitator URL — testnet: https://x402.org/facilitator
#                   mainnet: https://api.cdp.coinbase.com/platform/v2/x402
GENESIS_X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
GENESIS_X402_FACILITATOR_TIMEOUT_SECS=10

# ── Wallet Vault ─────────────────────────────────────────────────────────
# AES-256-GCM encrypted EVM key vault.
GENESIS_VAULT_PATH=genesis-vault.enc
GENESIS_VAULT_PASSPHRASE=

# ── Lineage Ledger ───────────────────────────────────────────────────────
# Append-only JSONL heredity ledger for all payment events.
GENESIS_LINEAGE_PATH=genesis-lineage.jsonl

# ── Action Prices (USDC atomic units, 6 decimals) ────────────────────────
# 1_000 = $0.001  |  5_000 = $0.005  |  100_000 = $0.100
GENESIS_PRICE_AI_CALL=1000
GENESIS_PRICE_AGENT_SPAWN=10000
GENESIS_PRICE_ASSET_TRANSFER=100000
GENESIS_PRICE_VAULT_MANAGE=50000
GENESIS_PRICE_VOICE_ACTION=5000

# ── Compute Provider API Keys (World Asset Accounts) ─────────────────────
# Rotate compromised keys immediately at their respective dashboards.

# Cloudflare API token (BANDWIDTH + COMPUTE assets)
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# OpenAI API key (INFERENCE_COMPUTE asset)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs API key (VOICE_COMPUTE asset)
# https://elevenlabs.io/app/settings → Profile → API Keys
ELEVENLABS_API_KEY=

# ── Database (Prisma / PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql://genesis:password@localhost:5432/genesis_ledger

# ── Blockchain (Polygon mainnet) ─────────────────────────────────────────
# DEPLOYER_PRIVATE_KEY is only for Hardhat deploy scripts — not loaded at runtime.
DEPLOYER_PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGONSCAN_API_KEY=

RUST_LOG=info
